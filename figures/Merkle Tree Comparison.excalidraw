   "seed": 570168,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "roundness": null,
   "text": "③ H3が異なるので、D3だけを送って揃える。",
   "originalText": "③ H3が異なるので、D3だけを送って揃える。",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle"
  },
  {
   "id": "e73",
   "type": "text",
   "x": 20,
   "y": 421.25,
   "width": 703.5,
   "height": 17.5,
