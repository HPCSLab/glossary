   "boundElements": null,
   "roundness": null,
   "text": "赤：部分和を上へ送り、\n　　各スイッチが足し合わせる",
   "originalText": "赤：部分和を上へ送り、\n　　各スイッチが足し合わせる",
   "fontSize": 13,
