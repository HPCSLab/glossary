   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "roundness": null,
   "text": "青：根の結果を全ノードへ配る",
   "originalText": "青：根の結果を全ノードへ配る",
   "fontSize": 13,
