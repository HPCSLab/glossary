   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "roundness": null,
   "text": "Allreduceの集約をスイッチが行うため、各リンクをデータが上りと下りに一度ずつ通るだけで済み、",
   "originalText": "Allreduceの集約をスイッチが行うため、各リンクをデータが上りと下りに一度ずつ通るだけで済み、",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle"
  },
  {
   "id": "e41",
   "type": "text",
   "x": 40,
   "y": 426.25,
   "width": 738.5,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
