  },
  {
   "id": "e103",
   "type": "text",
   "x": 61.47,
   "y": 591.88,
   "width": 557.05,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 815657,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "roundness": null,
   "text": "赤線はバタフライの一つ：2つの値 a, b から a + W·b と a − W·b を作る（W は回転因子）",
   "originalText": "赤線はバタフライの一つ：2つの値 a, b から a + W·b と a − W·b を作る（W は回転因子）",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle"
  },
  {
   "id": "e104",
   "type": "text",
   "x": 55.3,
   "y": 556.88,
   "width": 569.4,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 823576,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "roundness": null,
   "text": "N=8 では 3段 × 4個のバタフライ。一般に log2 N 段 × N/2 個なので、演算量は O(N log N)",
   "originalText": "N=8 では 3段 × 4個のバタフライ。一般に log2 N 段 × N/2 個なので、演算量は O(N log N)",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle"
  }
